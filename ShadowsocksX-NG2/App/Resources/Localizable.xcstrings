    "端口范围为 1025–65535，SOCKS 与 HTTP 代理端口必须不同": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "端口范围为 1025–65535，SOCKS 与 HTTP 代理端口必须不同"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ports must be between 1025 and 65535. SOCKS and HTTP ports must differ."
